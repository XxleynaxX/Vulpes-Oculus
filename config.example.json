{
  "_note": "Vulpes Oculus – Copy to config.json and fill in real values. Never commit config.json!",
  "project": "Vulpes Oculus",
  "mysql": {
    "MYSQL_URL": "mysql://USER:PASSWORD@HOST:3306/DATABASE",
    "MYSQL_HOST": "your-mysql-host.example.com",
    "MYSQL_PORT": "3306",
    "MYSQL_USER": "vulpes_user",
    "MYSQL_PASSWORD": "YOUR_SECURE_PASSWORD_HERE",
    "MYSQL_DATABASE": "vulpes_oculus",
    "MYSQL_SSL": "1",
    "MYSQL_SSL_CA": "",
    "MYSQL_POOL_SIZE": "5"
  },
  "discord_oauth": {
    "DISCORD_CLIENT_ID": "YOUR_DISCORD_APPLICATION_CLIENT_ID",
    "DISCORD_CLIENT_SECRET": "YOUR_DISCORD_CLIENT_SECRET",
    "AUTH_SECRET": "LONG_RANDOM_STRING_AT_LEAST_32_CHARACTERS",
    "PUBLIC_URL": "https://your-proxy.onrender.com",
    "ALLOWED_RETURN_ORIGINS": "https://yourname.github.io,https://vulpes-oculus.example.com,http://localhost:3000",
    "DISCORD_GUILD_ID": "YOUR_DISCORD_SERVER_ID",
    "ADMIN_ROLE_IDS": "ADMIN_ROLE_ID_1,ADMIN_ROLE_ID_2",
    "LIB_ROLE_IDS": "LIBRARY_ROLE_ID",
    "HEALER_ROLE_IDS": "HEALER_ROLE_ID",
    "SESSION_HOURS": "12"
  },
  "webhooks": {
    "DISCORD_WEATHER_WEBHOOK": "https://discord.com/api/webhooks/WEBHOOK_ID/WEBHOOK_TOKEN",
    "CHAR_WEBHOOK": "https://discord.com/api/webhooks/WEBHOOK_ID/WEBHOOK_TOKEN",
    "HEILER_WEBHOOK": "https://discord.com/api/webhooks/WEBHOOK_ID/WEBHOOK_TOKEN",
    "MOD_WEBHOOK": "https://discord.com/api/webhooks/WEBHOOK_ID/WEBHOOK_TOKEN"
  },
  "optional": {
    "MOD_WATCHER_SECRET": "",
    "WEATHER_KEEPALIVE": "1",
    "WEATHER_WINDOW_MIN": "10",
    "PORT": "3000"
  },
  "website": {
    "PROXY_URL": "https://your-proxy.onrender.com",
    "note": "Change DEFAULT_PROXY in vulpesoculus-storage.js OR: localStorage.setItem('vulpesoculus_discord_proxy_url', 'https://your-proxy.onrender.com')"
  }
}
